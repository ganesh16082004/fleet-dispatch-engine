# Backend local development configuration
# Never commit real credentials. Use your hosting provider's secret/environment UI in production.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/fleet_dispatch?appName=<app-name>
REDIS_URL=redis://default:<password>@<redis-host>:<port>
DRIVER_LOCATION_TTL=10m
KAFKA_BOOTSTRAP_SERVERS=lkc-<cluster-id>.<region>.aws.public.confluent.cloud:9092
KAFKA_API_KEY=<confluent-api-key>
KAFKA_API_SECRET=<confluent-api-secret>
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_CONSUMER_GROUP=fleet-dispatch-engine
KAFKA_TOPIC=fleet.events

# Road-network files
FLEET_NODES_FILE=data/processed/bengaluru/nodes.csv
FLEET_EDGES_FILE=data/processed/bengaluru/edges.csv
# Keep true for local development if the full graph is unavailable.
FLEET_ALLOW_DEMO_GRAPH=true

# Local WebSocket listeners
FLEET_WS_BIND_HOST=127.0.0.1
FLEET_DRIVER_WS_PORT=8087
FLEET_DASHBOARD_WS_PORT=8088
FLEET_HEARTBEAT_TIMEOUT_MILLIS=10000
